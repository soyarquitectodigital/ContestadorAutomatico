{
  "name": "contestador-automatico",
  "version": "1.0.0",
  "description": "Panel de control web y app de escritorio para un bot selectivo de WhatsApp con Baileys",
  "author": "Progoswa",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke",
    "desktop:build": "electron-builder --win"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.7.6",
    "@libsql/client": "^0.18.0",
    "baileys": "7.0.0-rc14",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
