# Puerto del panel web
PORT=3000

# Secreto para firmar la cookie de sesión del panel.
# Genera uno aleatorio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Carpeta donde se guardan config.json y auth_info (sesión de WhatsApp).
# En Docker se monta como volumen. Por defecto: ./data
# DATA_DIR=./data
# En Render: monta un disco persistente y usa DATA_DIR=/var/data (ver render.yaml)
# NOTA: si configuras Turso abajo, el disco deja de ser necesario (todo se
# guarda en la nube y los archivos locales solo sirven para migrar/respaldo).

# Persistencia en la nube con Turso (SQLite como servicio, plan gratis sin
# expiración: ideal para el plan free de Render, donde el disco se borra en
# cada reinicio). Al definir TURSO_DATABASE_URL, TODO se guarda en la nube:
# registros, cuentas, contraseña maestra y la sesión de WhatsApp.
# Sin estas variables se usan los archivos JSON de DATA_DIR como siempre.
# Crea la base gratis en https://app.turso.tech y copia URL y token:
# TURSO_DATABASE_URL=libsql://tu-base-tu-org.turso.io
# TURSO_AUTH_TOKEN=

# OPCIONAL: si defines MASTER_KEY, la contraseña maestra queda fijada por entorno
# y NO se pedirá crearla en el primer inicio.
# Si lo dejas comentado, la contraseña se crea la primera vez que abras el panel
# y se guarda hasheada (scrypt) en data/master.json.
# MASTER_KEY=

# Auto-ping: la app se consulta a sí misma cada pocos minutos para que Render
# (plan free) no suspenda el servicio. En Render no hace falta configurar nada:
# usa RENDER_EXTERNAL_URL, que Render inyecta automáticamente.
# Fuera de Render, define la URL pública para activarlo (sin barra final):
# SELF_PING_URL=https://mi-servicio.example.com
# Intervalo entre pings en minutos (por defecto 10, mínimo 1):
# SELF_PING_INTERVAL_MINUTES=10
